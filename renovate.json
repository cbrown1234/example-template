{
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/copier\\.ya?ml$/"
      ],
      "matchStrings": [
        "_min_copier_version:\\s*[\"'](?<currentValue>[^\"']+)[\"']"
      ],
      "depNameTemplate": "copier",
      "datasourceTemplate": "pypi"
    }
  ],
  "packageRules": [
    {
      "matchDatasources": [
        "docker"
      ],
      "matchFileNames": [
        "template/**"
      ],
      "matchUpdateTypes": [
        "pinDigest"
      ],
      "enabled": false
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchUpdateTypes": [
        "digest"
      ],
      "automerge": true,
      "prConcurrentLimit": 10
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "digest"
      ],
      "automerge": true,
      "prConcurrentLimit": 10
    },
    {
      "matchPackageNames": [
        "astral-sh/uv"
      ],
      "automerge": true,
      "prConcurrentLimit": 10
    },
    {
      "matchPackageNames": [
        "copier"
      ],
      "automerge": true,
      "groupName": "copier",
      "rangeStrategy": "bump",
      "prConcurrentLimit": 10
    },
    {
      "matchPackageNames": [
        "go-task/task"
      ],
      "automerge": true,
      "prConcurrentLimit": 10
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "prConcurrentLimit": 10
  },
  "prConcurrentLimit": 7,
  "extends": [
    "customManagers:githubActionsVersions",
    "config:best-practices"
  ],
  "$schema": "https://docs.renovatebot.com/renovate-schema.json"
}
